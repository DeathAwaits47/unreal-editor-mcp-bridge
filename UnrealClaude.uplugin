{
	"FileVersion": 3,
	"Version": 13,
	"VersionName": "1.5.1",
	"FriendlyName": "Unreal Editor MCP Bridge",
	"Description": "A local, MCP-compatible Unreal Engine 5.7 editor bridge for AI clients. Includes careful Sequencer, world-building, performance, and material-audit tooling.",
	"Category": "Editor",
	"CreatedBy": "Natali Caggiano",
	"CreatedByURL": "https://github.com/Natfii",
	"DocsURL": "https://github.com/DeathAwaits47/unreal-editor-mcp-bridge",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/DeathAwaits47/unreal-editor-mcp-bridge/issues",
	"EngineVersion": "5.7.0",
	"CanContainContent": false,
	"Installed": true,
	"SupportedTargetPlatforms": [
		"Win64",
		"Linux",
		"Mac"
	],
	"Modules": [
		{
			"Name": "UnrealClaude",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [
				"Win64",
				"Linux",
				"Mac"
			]
		}
	],
	"Plugins": [
		{
			"Name": "EditorScriptingUtilities",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "EnhancedInput",
			"Enabled": true
		},
		{
			"Name": "SequencerScripting",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "ControlRig",
			"Enabled": true,
			"Optional": true
		}
	]
}
